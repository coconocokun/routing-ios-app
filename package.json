{
  "name": "walking-study-ios",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client",
    "web": "expo start --web --localhost",
    "prebuild:ios": "node scripts/stage-watch.cjs && expo prebuild --platform ios",
